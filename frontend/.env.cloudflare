# Build for the Cloudflare frontend Worker (vite build --mode cloudflare). No secrets here.
# API calls stay on the same origin (/api/*) and reach catalogo-lite-api through the
# service binding in wrangler.jsonc: no CORS dependency and ready for custom domains.
VITE_PUBLIC_DEMO=false
VITE_API_URL=
# Commercial site used by the "Creado con TiendIA Exprés" attribution. Switch to the official domain
# Official domain, live with HTTPS since 2026-11-10.
VITE_PLATFORM_SITE_URL=https://tiendiaexpres.com/
