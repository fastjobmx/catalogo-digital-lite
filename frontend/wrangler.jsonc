{
  // Frontend of Catálogo Digital IA on Cloudflare Workers Static Assets.
  // Deploy:  npm run deploy:cloudflare  (build with .env.cloudflare, then wrangler deploy)
  // Public URL: https://catalogo-digital-ia.catalogo-lite-worker.workers.dev
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "catalogo-digital-ia",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /t/<tienda>/admin, /plataforma, /admin/... reload without 404.
    "not_found_handling": "single-page-application",
    // Only API paths run the script; every other request is a free static asset hit.
    "run_worker_first": ["/api/*"]
  },
  // Backend Worker (unchanged): images under /api/assets/* and any relative /api call.
  "services": [{ "binding": "API", "service": "catalogo-lite-api" }],
  "observability": { "enabled": true }
}
