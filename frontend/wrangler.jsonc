{
  // Frontend of the Tienda IA Express platform (technical name catalogo-digital-ia) on Workers Static Assets.
  // Deploy:  npm run deploy:cloudflare  (build with .env.cloudflare, then wrangler deploy)
  // Public URLs: https://app.tiendiaexpres.com (official) and https://catalogo-digital-ia.catalogo-lite-worker.workers.dev
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "catalogo-digital-ia",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /t/<tienda>/admin, /plataforma, /admin/... reload without 404.
    "not_found_handling": "single-page-application",
    // API paths and HTML pages run the script (pages get per-store share metadata, see cloudflare/worker.js);
    // static files under these folders are served directly without running it.
    "run_worker_first": ["/*", "!/assets/*", "!/brand/*", "!/seed-images/*", "!/favicon.svg"]
  },
  // Backend Worker (unchanged): images under /api/assets/* and any relative /api call.
  "services": [{ "binding": "API", "service": "catalogo-lite-api" }],
  "observability": { "enabled": true },
  // Official domain (authorised 2026-11-10; see docs/DOMINIO_SEO_CORREO.md). workers.dev keeps working.
  "routes": [{ "pattern": "app.tiendiaexpres.com", "custom_domain": true }],
  // CANONICAL_ORIGIN sets canonical URLs, og:url and sitemaps; REDIRECT_TO_CANONICAL=true sends a 301 from
  // other hostnames (workers.dev) to it — never for /api/*, so Telegram buttons and image URLs keep working.
  // Stage 2 (2026-11-10): app.tiendiaexpres.com verified, so workers.dev answers 301 to it (except /api/*).
  "vars": { "CANONICAL_ORIGIN": "https://app.tiendiaexpres.com", "REDIRECT_TO_CANONICAL": "true" }
}
