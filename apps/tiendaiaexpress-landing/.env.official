# Official production build (npm run build:official / npm run cf:deploy). Public values only, no secrets.
VITE_SITE_URL=https://tiendiaexpres.com
VITE_APP_URL=https://app.tiendiaexpres.com
# Indexable since the official launch (2026-11-10).
VITE_ALLOW_INDEXING=true
# Hostnames that serve the same files but must never be indexed (only the canonical domain is).
VITE_NOINDEX_HOSTS=www.tiendiaexpres.com,tiendaiaexpress.pages.dev
