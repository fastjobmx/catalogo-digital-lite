# Copy to .env.production (or .env.local) and adjust. Every value has a safe default.
# Public URL of this site (canonical, Open Graph and sitemap). Official domain once it is verified:
#   VITE_SITE_URL=https://tiendiaexpres.com
VITE_SITE_URL=https://tiendaiaexpress.pages.dev
# Platform app (stores, panel and trial). Official subdomain once it is verified:
#   VITE_APP_URL=https://app.tiendiaexpres.com
VITE_APP_URL=https://catalogo-digital-ia.catalogo-lite-worker.workers.dev
# false (default) = noindex everywhere (meta, X-Robots-Tag header, no sitemap, no canonical).
# true = indexable: canonical + sitemap + robots "index, follow". Turn on only at the official launch.
VITE_ALLOW_INDEXING=false
