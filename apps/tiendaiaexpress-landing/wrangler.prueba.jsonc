{
  // Vista previa AISLADA de la landing (prueba gratis real): archivos estáticos, sin bindings ni secretos, noindex.
  // Publicar: vite build --mode prueba (+ SSR y prerender) y wrangler deploy -c wrangler.prueba.jsonc
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "tiendia-prueba-landing",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
