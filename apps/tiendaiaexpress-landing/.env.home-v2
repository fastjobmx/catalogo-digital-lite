# Test URL of the Home V2 as the home page (npm run build:home-v2 / npm run cf:preview:home-v2).
# Cloudflare Pages preview branch "home-v2" (never the production branch "main"). Public values only, no secrets.
# Never indexable: noindex on every page, no canonical and no sitemap. Links go to the real platform.
VITE_HOME_V2=home
VITE_SITE_URL=https://home-v2.tiendaiaexpress.pages.dev
VITE_APP_URL=https://app.tiendiaexpres.com
VITE_ALLOW_INDEXING=false
