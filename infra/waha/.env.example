# Plantilla. El archivo real (.env) se genera con: node scripts/init-env.mjs
# Nunca subir .env a Git ni pegar sus valores en chats, tickets o capturas.

# Clave administrativa de WAHA (solo este equipo; el Worker usa una clave de sesión limitada).
WAHA_API_KEY=sha512:<hash>
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=tiendia
WAHA_DASHBOARD_PASSWORD=<aleatoria>

# Sesión exclusiva del asistente.
WAHA_SESSION=tiendia

# Webhook hacia el Worker de producción y su firma HMAC-SHA512.
WHATSAPP_HOOK_URL=https://app.tiendiaexpres.com/api/whatsapp/waha/webhook
WHATSAPP_HOOK_HMAC_KEY=<aleatoria>

# Token que el gateway exige al Worker (además de la clave de sesión).
WAHA_GATEWAY_TOKEN=<aleatoria>

# Token del túnel fijo waha.tiendiaexpres.com (cloudflared tunnel token tiendia-waha).
TUNNEL_TOKEN=<token-del-tunel>
