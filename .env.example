# ============================================
# CATÁLOGO DIGITAL LITE - Variables de entorno
# ============================================
# Copia este archivo como .env y reemplaza los valores ficticios.
# NUNCA subas .env al repositorio.

# --- Cloudflare Workers / D1 / R2 ---
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui
CLOUDFLARE_API_TOKEN=tu_api_token_aqui
D1_DATABASE_NAME=catalogo-lite-db
R2_BUCKET_NAME=catalogo-lite-assets

# --- Autenticación Admin ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CambiaEstaContrasenaSegura123!
JWT_SECRET=genera_un_secret_aleatorio_de_32_chars_minimo
COOKIE_SECRET=genera_otro_secret_aleatorio_para_cookies

# --- Telegram Bot (opcional, Fase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
# Límites opcionales para importaciones masivas de Telegram (100 productos y 200 MiB por lote por defecto).
TELEGRAM_BATCH_MAX_ITEMS=100
TELEGRAM_BATCH_MAX_BYTES=209715200

# --- Google Gemini AI (opcional, Fase 4) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Plataforma multitienda 3.0 (opcional) ---
# URL pública del storefront: las tiendas viven en <url>/t/<dirección>.
PUBLIC_STORE_BASE_URL=http://localhost:5173
# Usuario público del asistente compartido de tiendas (sin @), para enlaces t.me.
TELEGRAM_BOT_USERNAME=
# Bot maestro (token propio, distinto del asistente de tiendas).
MASTER_BOT_TOKEN=
MASTER_WEBHOOK_SECRET=
# IDs numéricos de Telegram autorizados en el bot maestro, separados por coma.
MASTER_ADMIN_TELEGRAM_IDS=
# Estimación de costo de Gemini en micros de USD por millón de tokens.
GEMINI_PRICE_INPUT_MICROS_PER_MTOK=300000
GEMINI_PRICE_OUTPUT_MICROS_PER_MTOK=2500000
# Tope global mensual opcional de IA (micros de USD). Vacío = sin tope global.
PLATFORM_AI_MONTHLY_CAP_MICROS=

# --- Correo transaccional (Worker catalogo-lite-api) ---
# Sin estas variables cada envío queda registrado como "no configurado" (nunca se finge un envío).
# RESEND_API_KEY y RESEND_WEBHOOK_SECRET son SECRETOS: cárgalos con `wrangler secret put`, nunca aquí.
EMAIL_PROVIDER=
EMAIL_FROM=
# Dirección con bandeja o reenvío real (p. ej. soporte@<dominio> con Cloudflare Email Routing).
EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Direcciones extra autorizadas para correos de prueba (separadas por coma).
EMAIL_TEST_RECIPIENTS=
# Días que se conserva el historial de envíos (por defecto 180, mínimo 30).
EMAIL_LOG_RETENTION_DAYS=180

# --- Configuración de la tienda demo ---
STORE_NAME=SneakerHub Lite
STORE_CURRENCY=COP
STORE_COUNTRY=CO
STORE_WHATSAPP=+573001112233

# --- Desarrollo local ---
NODE_ENV=development
# En desarrollo el frontend usa el proxy de Vite; deja VITE_API_URL vacío.
# En producción define la URL pública del Worker, p. ej. https://tu-worker.workers.dev
VITE_API_URL=
VITE_API_PROXY=http://localhost:8788
PORT=5173
