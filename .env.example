# ============================================
# CATÁLOGO DIGITAL LITE - Variables de entorno
# ============================================
# Copia este archivo como .env y reemplaza los valores ficticios.
# NUNCA subas .env al repositorio.

# --- Cloudflare Workers / D1 / R2 ---
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui
CLOUDFLARE_API_TOKEN=tu_api_token_aqui
D1_DATABASE_NAME=catalogo-lite-db
R2_BUCKET_NAME=catalogo-lite-assets

# --- Autenticación Admin ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CambiaEstaContrasenaSegura123!
JWT_SECRET=genera_un_secret_aleatorio_de_32_chars_minimo
COOKIE_SECRET=genera_otro_secret_aleatorio_para_cookies

# --- Telegram Bot (opcional, Fase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=

# --- Google Gemini AI (opcional, Fase 4) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Configuración de la tienda demo ---
STORE_NAME=SneakerHub Lite
STORE_CURRENCY=COP
STORE_COUNTRY=CO
STORE_WHATSAPP=+573001112233

# --- Desarrollo local ---
NODE_ENV=development
# En desarrollo el frontend usa el proxy de Vite; deja VITE_API_URL vacío.
# En producción define la URL pública del Worker, p. ej. https://tu-worker.workers.dev
VITE_API_URL=
VITE_API_PROXY=http://localhost:8788
PORT=5173